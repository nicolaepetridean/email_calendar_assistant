# ── Required ──────────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

MANAGER_EMAIL=manager@example.com
MONITORED_EMAIL=inbox@example.com        # informational — whose inbox is being watched

# ── Polling & scheduling ───────────────────────────────────────────────────────
POLL_INTERVAL=60                         # seconds between inbox polls
CALENDAR_ID=primary                      # Google Calendar to read/write
MEETING_LOOKAHEAD_DAYS=5                 # how many business days ahead to search
MEETING_SLOT_COUNT=3                     # number of slot options to offer manager
WORKING_HOURS_START=9                    # UTC hour — start of bookable day
WORKING_HOURS_END=17                     # UTC hour — end of bookable day
DEFAULT_MEETING_DURATION=60              # minutes, used when email doesn't specify
SLOT_STEP_MINUTES=30                     # granularity of free-slot search

# ── Behaviour ──────────────────────────────────────────────────────────────────
AUTO_DECLINE_SALES=true                  # set to false to suppress polite decline replies

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                          # text (human-readable) | json (log aggregators)

# ── Paths (pre-set for Docker; override for local runs) ───────────────────────
CREDENTIALS_PATH=/credentials/credentials.json
TOKEN_PATH=/credentials/token.json
DB_PATH=/data/agent.db
